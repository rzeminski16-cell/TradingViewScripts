//@version=5
indicator("Gains Period Highlighter", overlay=true)

// Input parameters
gainThreshold = input.float(5.0, title="Gain Threshold (%)", minval=0.1, step=0.1)
periodLength = input.int(5, title="Period Length (Days)", minval=1)
highlightColor = input.color(color.new(color.green, 80), title="Highlight Color")

// Calculate midpoint
midpoint = hl2

// Variables to track qualifying periods
var int lastPeriodEnd = 0
var array<int> qualifyingPeriods = array.new_int()
var array<int> qualifyingYears = array.new_int()
var array<int> qualifyingQuarters = array.new_int()

// Check if we have enough bars and can check for a new period
if bar_index >= periodLength - 1
    // Calculate the bar index where we would START a period
    potentialStartBar = bar_index - periodLength + 1

    // Check if we can start looking for a new period (not in skip zone)
    canCheckPeriod = potentialStartBar >= lastPeriodEnd

    if canCheckPeriod
        // Get midpoint from periodLength bars ago (start of period)
        startMidpoint = midpoint[periodLength - 1]

        // Get midpoint of current bar (end of period)
        endMidpoint = midpoint

        // Calculate gain percentage
        gainPercent = ((endMidpoint - startMidpoint) / startMidpoint) * 100

        // Check if gain meets threshold
        if gainPercent >= gainThreshold
            // Mark the START bar as a qualifying period
            array.push(qualifyingPeriods, potentialStartBar)

            // Get year and quarter from the START bar
            barYear = year(time[periodLength - 1])
            barMonth = month(time[periodLength - 1])
            barQuarter = math.floor((barMonth - 1) / 3) + 1

            array.push(qualifyingYears, barYear)
            array.push(qualifyingQuarters, barQuarter)

            // Draw a box to highlight the entire period
            startTime = time[periodLength - 1]
            endTime = time
            boxTop = high[periodLength - 1]
            boxBottom = low[periodLength - 1]

            // Find highest high and lowest low in the period
            for j = 0 to periodLength - 1
                boxTop := math.max(boxTop, high[j])
                boxBottom := math.min(boxBottom, low[j])

            // Draw box with some padding
            box.new(startTime, boxTop, endTime, boxBottom,
                    border_color=na,
                    bgcolor=highlightColor,
                    extend=extend.none)

            // Skip forward by periodLength days from the start bar
            lastPeriodEnd := potentialStartBar + periodLength

// Create table to show quarterly counts
var table statsTable = na

if barstate.islast
    // Count periods by quarter/year
    var map<string, int> quarterCounts = map.new<string, int>()

    for i = 0 to array.size(qualifyingPeriods) - 1
        yr = array.get(qualifyingYears, i)
        qtr = array.get(qualifyingQuarters, i)
        key = str.tostring(yr) + " Q" + str.tostring(qtr)

        currentCount = map.get(quarterCounts, key)
        if na(currentCount)
            map.put(quarterCounts, key, 1)
        else
            map.put(quarterCounts, key, currentCount + 1)

    // Build table with correct dimensions
    numQuarters = map.size(quarterCounts)

    if numQuarters > 0
        // Delete old table and create new one with correct size (header + data rows)
        if not na(statsTable)
            table.delete(statsTable)
        statsTable := table.new(position.top_right, 2, numQuarters + 1, border_width=1)

        // Header
        table.cell(statsTable, 0, 0, "Quarter", bgcolor=color.gray, text_color=color.white, text_size=size.small)
        table.cell(statsTable, 1, 0, "Count", bgcolor=color.gray, text_color=color.white, text_size=size.small)

        // Data rows
        row = 1
        keys = map.keys(quarterCounts)
        values = map.values(quarterCounts)

        for i = 0 to array.size(keys) - 1
            quarterKey = array.get(keys, i)
            count = array.get(values, i)

            table.cell(statsTable, 0, row, quarterKey, bgcolor=color.white, text_color=color.black, text_size=size.small)
            table.cell(statsTable, 1, row, str.tostring(count), bgcolor=color.white, text_color=color.black, text_size=size.small)
            row := row + 1
    else
        // Delete old table and create simple message table
        if not na(statsTable)
            table.delete(statsTable)
        statsTable := table.new(position.top_right, 1, 1, border_width=1)
        table.cell(statsTable, 0, 0, "No qualifying periods found", bgcolor=color.white, text_color=color.black, text_size=size.small)
